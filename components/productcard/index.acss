.product-card {
  display: flex;
  flex-direction: column;
  width: 100%;
  background-color: #ffffff;
}

.product-image-wrapper {
  position: relative;
  width: 100%;
  height: 300rpx;
  overflow: hidden;
}

.product-image {
  width: 100%;
  height: 100%;
}

.product-badge {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  padding: 8rpx 16rpx;
  background-color: #474646;
}

.badge-text {
  font-size: 20rpx;
  font-weight: 500;
  color: #ffffff;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.product-info {
  padding: 20rpx 16rpx;
  display: flex;
  flex-direction: column;
}

.product-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #474646;
  letter-spacing: 0.5rpx;
  margin-bottom: 8rpx;
}

.product-description {
  font-size: 22rpx;
  font-weight: 400;
  color: #888888;
  margin-bottom: 12rpx;
}

.product-pricing {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.product-price {
  font-size: 28rpx;
  font-weight: 600;
  color: #474646;
}

.product-original-price {
  margin-left: 12rpx;
  font-size: 24rpx;
  font-weight: 400;
  color: #bebebe;
  text-decoration: line-through;
}
