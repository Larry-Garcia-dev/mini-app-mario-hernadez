.hero-container {
  position: relative;
  width: 100%;
  flex: 1;
  min-height: 600rpx;
  overflow: hidden;
}

.hero-image {
  width: 100%;
  height: 100%;
  min-height: 600rpx;
}

.hero-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 40rpx 32rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.5));
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}

.hero-subtitle {
  font-size: 28rpx;
  font-weight: 400;
  color: #ffffff;
  opacity: 0.9;
}
