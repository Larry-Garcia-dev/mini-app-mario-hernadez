.page-container {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
}

/* Background Hero Image - Fixed full screen */
.hero-background {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.hero-bg-image {
  width: 100%;
  height: 100%;
}

/* Content Overlay on top of image */
.content-overlay {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
}

/* Menu container with slide-up animation */
/* Altura para 4 items exactos: (padding 56rpx + line-height ~32rpx + borde 1rpx) * 4 = ~356rpx */
.menu-container {
  height: 32vh;
  background-color: rgba(255, 255, 255, 0.95);
  transition: transform 0.6s ease-out, opacity 0.6s ease-out;
}

/* Initial state - menu at bottom */
.menu-initial {
  transform: translateY(100vh);
  opacity: 0;
}

/* Animated state - menu slides up to position */
.menu-slide-up {
  transform: translateY(0);
  opacity: 1;
}
