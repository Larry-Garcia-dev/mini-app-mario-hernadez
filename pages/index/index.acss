.page-container {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
}

/* Background Hero Image - Fixed full screen */
.hero-background {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.hero-bg-image {
  width: 100%;
  height: 100%;
}

/* Content Overlay on top of image */
.content-overlay {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
}

/* Menu container with scroll */
.menu-container {
  overflow: hidden;
  transition: max-height 0.3s ease, opacity 0.3s ease;
  background-color: rgba(255, 255, 255, 0.95);
}

.menu-open {
  max-height: 500rpx;
  opacity: 1;
}

.menu-closed {
  max-height: 0;
  opacity: 0;
}
