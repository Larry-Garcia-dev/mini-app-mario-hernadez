<view class="page-container">
  <!-- Background Hero Image - Fixed -->
  <view class="hero-background">
    <image class="hero-bg-image" src="{{heroImageSrc}}" mode="aspectFill" />
  </view>

  <!-- Content Overlay -->
  <view class="content-overlay {{menuAnimated ? 'animated' : ''}}">
    <!-- Header Component - Sin toggle en index -->
    <header 
      brandName="{{brandName}}"
      showToggle="{{false}}"
      showMenuIcon="{{false}}"
    />

    <!-- Navigation Menu with slide-up animation -->
    <scroll-view 
      class="menu-container {{menuAnimated ? 'menu-slide-up' : 'menu-initial'}}"
      scroll-y="{{true}}"
      

    >
      <view a:for="{{menuItems}}" a:key="id">
        <menuitem
          id="{{item.id}}"
          label="{{item.label}}"
          route="{{item.route}}"
          showArrow="{{true}}"
          onTap="handleMenuItemTap"
        />
      </view>
    </scroll-view>
  </view>
</view>
