.page-container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #f5ebe0;
}

/* Address Section */
.address-section {
  background-color: #ffffff;
  padding: 24rpx 32rpx;
  margin-top: 16rpx;
}

.address-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.address-text {
  font-size: 28rpx;
  color: #474646;
}

.change-address {
  font-size: 26rpx;
  color: #474646;
  text-decoration: underline;
}

/* Order Section */
.order-section {
  background-color: #f5ebe0;
  padding: 24rpx 32rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #474646;
  margin-bottom: 24rpx;
}

.cart-items {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.cart-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.cart-item:last-child {
  border-bottom: none;
}

.item-image-container {
  width: 120rpx;
  height: 120rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-right: 24rpx;
}

.item-image {
  width: 80%;
  height: 80%;
}

.item-details {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.item-name {
  font-size: 26rpx;
  color: #474646;
  margin-bottom: 8rpx;
  line-height: 1.3;
}

.item-price {
  font-size: 28rpx;
  font-weight: 600;
  color: #474646;
}

.item-remove {
  font-size: 24rpx;
  color: #474646;
  text-decoration: underline;
}

/* Spacer */
.spacer {
  flex: 1;
}

/* Invoice Section */
.invoice-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx;
  background-color: #f5ebe0;
}

.invoice-question {
  font-size: 28rpx;
  color: #474646;
  margin-bottom: 24rpx;
}

.invoice-buttons {
  display: flex;
  flex-direction: row;
  gap: 24rpx;
}

.invoice-btn {
  padding: 16rpx 48rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 24rpx;
  background-color: #ffffff;
}

.invoice-btn.active {
  background-color: #474646;
}

.invoice-btn-text {
  font-size: 26rpx;
  color: #474646;
}

.invoice-btn.active .invoice-btn-text {
  color: #ffffff;
}

/* Payment Bar */
.payment-bar {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  background-color: #e8ddd4;
}

.total-price {
  font-size: 36rpx;
  font-weight: 600;
  color: #474646;
}

.pay-button {
  background-color: #c4b5a6;
  border-radius: 32rpx;
  padding: 24rpx 64rpx;
}

.pay-button-text {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 500;
}
