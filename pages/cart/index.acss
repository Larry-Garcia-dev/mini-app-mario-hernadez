.page-container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #F8F7F6;
}

/* Address Section */
.address-section {
  background-color: #F8F7F6;
  padding: 24rpx 32rpx;
  margin-top: 16rpx;
}

.address-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.address-text {
  font-size: 28rpx;
  color: #474646;
}

.change-address {
  font-size: 26rpx;
  color: #474646;
  text-decoration: underline;
}

/* Order Section */
.order-section {
  background-color: #F8F7F6;
  padding: 24rpx 32rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #474646;
  margin-bottom: 24rpx;
}

/* Empty Cart */
.empty-cart {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 64rpx 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.empty-cart-icon {
  position: relative;
  width: 80rpx;
  height: 70rpx;
  margin-bottom: 24rpx;
}

.empty-icon-body {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  width: 48rpx;
  height: 36rpx;
  border: 4rpx solid #c0c0c0;
  border-top: none;
  border-radius: 0 0 8rpx 8rpx;
}

.empty-icon-wheel {
  position: absolute;
  bottom: 0;
  width: 14rpx;
  height: 14rpx;
  background-color: #c0c0c0;
  border-radius: 50%;
}

.empty-icon-wheel.left {
  left: 20rpx;
}

.empty-icon-wheel.right {
  right: 20rpx;
}

.empty-cart-text {
  font-size: 28rpx;
  color: #888888;
  margin-bottom: 32rpx;
  text-align: center;
}

.empty-cart-button {
  background-color: #474646;
  border-radius: 24rpx;
  padding: 20rpx 48rpx;
}

.empty-cart-button-text {
  font-size: 26rpx;
  color: #ffffff;
  font-weight: 500;
}

.cart-items {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.cart-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.cart-item:last-child {
  border-bottom: none;
}

.item-image-container {
  width: 120rpx;
  height: 120rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  overflow: hidden;
  margin-right: 24rpx;
}

.item-image {
  width: 100%;
  height: 100%;
}

.item-details {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.item-name {
  font-size: 26rpx;
  color: #474646;
  margin-bottom: 8rpx;
  line-height: 1.3;
}

.item-price {
  font-size: 28rpx;
  font-weight: 600;
  color: #474646;
}

.item-remove {
  font-size: 24rpx;
  color: #474646;
  text-decoration: underline;
}

/* Spacer */
.spacer {
  flex: 1;
}

/* Invoice Section */
.invoice-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx;
  background-color: #F8F7F6;
}

.invoice-question {
  font-size: 28rpx;
  color: #474646;
  margin-bottom: 24rpx;
}

.invoice-buttons {
  display: flex;
  flex-direction: row;
  gap: 24rpx;
}

.invoice-btn {
  padding: 16rpx 48rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 24rpx;
  background-color: #ffffff;
}

.invoice-btn.active {
  background-color: #474646;
}

.invoice-btn-text {
  font-size: 26rpx;
  color: #474646;
}

.invoice-btn.active .invoice-btn-text {
  color: #ffffff;
}

/* NIT Input Container */
.nit-container {
  width: 100%;
  margin-top: 32rpx;
  transition: opacity 0.3s ease, max-height 0.3s ease;
  overflow: visible;
}

.nit-container.show {
  opacity: 1;
  max-height: 300rpx;
}

.nit-container.hide {
  opacity: 0;
  max-height: 0;
  overflow: hidden;
}

.nit-label {
  font-size: 28rpx;
  color: #474646;
  margin-bottom: 16rpx;
  display: block;
}

.nit-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border: 2rpx solid #c0c0c0;
  border-radius: 12rpx;
  background-color: #ffffff;
  font-size: 30rpx;
  color: #474646;
  box-sizing: border-box;
  line-height: 88rpx;
}

/* Payment Bar */
.payment-bar {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  background-color: #FFFFFF;
  border-radius: 40rpx 40rpx 0rpx 0rpx;
  border: gainsboro 1px solid;
}

.total-price {
  font-size: 36rpx;
  font-weight: 600;
  color: #474646;
}

.pay-button {
  background-color: black;
  border-radius: 32rpx;
  padding: 24rpx 64rpx;
}

.pay-button-text {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 500;
}
