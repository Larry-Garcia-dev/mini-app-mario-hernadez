<view class="page-container">
  <!-- Header Component -->
  <header 
    brandName="{{brandName}}"
    showToggle="{{false}}"
    showMenuIcon="{{true}}"
  />

  <!-- Product Image Gallery -->
  <swiper 
    class="product-gallery"
    indicator-dots="{{true}}"
    indicator-color="rgba(255,255,255,0.5)"
    indicator-active-color="#ffffff"
  >
    <swiper-item a:for="{{product.images}}" a:key="index">
      <image 
        class="gallery-image" 
        src="{{item}}" 
        mode="aspectFill"
      />
    </swiper-item>
  </swiper>

  <!-- Product Info -->
  <view class="product-info">
    <view class="product-header">
      <text class="product-name">{{product.name}}</text>
      <text class="product-reference">Ref: {{product.reference}}</text>
    </view>

    <view class="product-pricing">
      <text class="product-price">{{product.currency}}{{product.price}}</text>
      <text class="product-original-price" a:if="{{product.originalPrice}}">
        {{product.currency}}{{product.originalPrice}}
      </text>
    </view>

    <view class="product-description">
      <text class="description-title">Descripcion</text>
      <text class="description-text">{{product.description}}</text>
    </view>

    <!-- Color Options -->
    <view class="product-options" a:if="{{product.colors.length > 0}}">
      <text class="options-title">Color</text>
      <view class="color-options">
        <view 
          class="color-option {{selectedColor === item.id ? 'selected' : ''}}"
          a:for="{{product.colors}}"
          a:key="id"
          data-color="{{item}}"
          onTap="selectColor"
        >
          <view class="color-circle" style="background-color: {{item.hex}}"></view>
          <text class="color-name">{{item.name}}</text>
        </view>
      </view>
    </view>

    <!-- Product Details -->
    <view class="product-details">
      <text class="details-title">Detalles</text>
      <view class="details-list">
        <view class="detail-item" a:for="{{product.details}}" a:key="index">
          <text class="detail-text">- {{item}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- Add to Cart Button -->
  <view class="bottom-actions">
    <view class="add-to-cart-button" onTap="addToCart">
      <text class="button-text">Agregar al Carrito</text>
    </view>
  </view>
</view>
