.page-container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #ffffff;
  padding-bottom: 120rpx;
}

/* Product Gallery */
.product-gallery {
  width: 100%;
  height: 600rpx;
}

.gallery-image {
  width: 100%;
  height: 100%;
}

/* Product Info */
.product-info {
  padding: 32rpx;
}

.product-header {
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
}

.product-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #474646;
  letter-spacing: 1rpx;
  margin-bottom: 8rpx;
}

.product-reference {
  font-size: 24rpx;
  font-weight: 400;
  color: #888888;
}

/* Pricing */
.product-pricing {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 32rpx;
  padding-bottom: 32rpx;
  border-bottom: 1rpx solid #e5e5e5;
}

.product-price {
  font-size: 36rpx;
  font-weight: 600;
  color: #474646;
}

.product-original-price {
  margin-left: 16rpx;
  font-size: 28rpx;
  font-weight: 400;
  color: #bebebe;
  text-decoration: line-through;
}

/* Description */
.product-description {
  margin-bottom: 32rpx;
}

.description-title,
.options-title,
.details-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #474646;
  margin-bottom: 16rpx;
}

.description-text {
  font-size: 26rpx;
  font-weight: 400;
  color: #666666;
  line-height: 1.6;
}

/* Color Options */
.product-options {
  margin-bottom: 32rpx;
}

.color-options {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.color-option {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 32rpx;
  margin-bottom: 16rpx;
  padding: 16rpx;
  border: 2rpx solid transparent;
  border-radius: 8rpx;
}

.color-option.selected {
  border-color: #474646;
}

.color-circle {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  margin-bottom: 8rpx;
  border: 1rpx solid #e5e5e5;
}

.color-name {
  font-size: 22rpx;
  font-weight: 400;
  color: #666666;
}

/* Product Details */
.product-details {
  margin-bottom: 32rpx;
}

.details-list {
  display: flex;
  flex-direction: column;
}

.detail-item {
  margin-bottom: 12rpx;
}

.detail-text {
  font-size: 26rpx;
  font-weight: 400;
  color: #666666;
}

/* Bottom Actions */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  background-color: #ffffff;
  border-top: 1rpx solid #e5e5e5;
}

.add-to-cart-button {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  height: 88rpx;
  background-color: #474646;
  border-radius: 8rpx;
}

.button-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}
