.page-container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #ffffff;
  padding-bottom: 140rpx;
}
/* Success Section */
.success-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx;
}
.success-icon {
  margin-bottom: 16rpx;
}
.check-circle {
  width: 100rpx;
  height: 100rpx;
  border: 6rpx solid #35d09b;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  position: relative;
}
.check-mark {
  width: 40rpx;
  height: 24rpx;
  border-left: 6rpx solid #35d09b;
  border-bottom: 6rpx solid #35d09b;
  transform: rotate(-45deg);
  position: relative;
  top: -6rpx;
}
.success-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #35d09b;
}
/* Order Card */
.order-card {
  margin: 0 32rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}
.date-header {
  background-color: #35d09b;
  padding: 28rpx 32rpx;
}
.date-text {
  font-size: 30rpx;
  font-weight: 500;
  color: #ffffff;
  text-align: center;
  display: block;
}
/* Details Section */
.details-section {
  background-color: #ffffff;
  padding: 32rpx;
}
.details-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #474646;
  text-align: center;
  display: block;
  margin-bottom: 20rpx;
}
.details-divider {
  height: 2rpx;
  background-color: #e0e0e0;
  margin-bottom: 32rpx;
}
.details-list {
  display: flex;
  flex-direction: column;
}
.detail-item {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin-bottom: 28rpx;
}
.detail-item:last-child {
  margin-bottom: 0;
}
.bullet {
  width: 12rpx;
  height: 12rpx;
  background-color: #474646;
  border-radius: 50%;
  margin-right: 16rpx;
  margin-top: 10rpx;
  flex-shrink: 0;
}
.detail-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #474646;
  margin-right: 8rpx;
}
.detail-value {
  font-size: 28rpx;
  font-weight: 400;
  color: #888888;
  flex: 1;
}
/* Bottom Bar */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  background-color: #ffffff;
}
.finish-button {
  background-color: #1a1a1a;
  border-radius: 50rpx;
  padding: 28rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}
.finish-button-text {
  font-size: 30rpx;
  font-weight: 500;
  color: #ffffff;
}