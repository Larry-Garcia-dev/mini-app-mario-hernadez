.page-container {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  width: 100%;
  height: 100vh;
  background-color: #ffffff;
}
.logo-container {
  position: relative;
  width: 300rpx;
  height: 300rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}
.logo-stage {
  position: absolute;
  width: 100%;
  height: 100%;
  transition: opacity 0.6s ease-in-out;
}
.logo-stage.hidden {
  opacity: 0;
}
.logo-stage.visible {
  opacity: 1;
}
.loading-text-container {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 48rpx;
  transition: opacity 0.4s ease-in-out;
}
.loading-text-container.hidden {
  opacity: 0;
}
.loading-text-container.visible {
  opacity: 1;
}
.loading-text {
  font-size: 28rpx;
  color: #8B7830;
  font-weight: 400;
  letter-spacing: 2rpx;
}
.loading-dots {
  font-size: 28rpx;
  color: #8B7830;
  font-weight: 400;
  width: 40rpx;
}